# Copy to .env and fill in. Never commit the real file.

# Your Atlassian Cloud site, no trailing slash.
JIRA_BASE_URL=https://your-site.atlassian.net

# The account the server authenticates as. Give it the least access that works:
# read on the projects you analyse, and comment permission only if you intend
# to enable writes at all.
JIRA_EMAIL=you@example.com

# Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-api-token

# Where drafts and the audit log are written. Relative paths resolve against
# the working directory the server is started in.
JIRA_MCP_STATE_DIR=.jira-mcp

# Writes are OFF unless this is exactly "true". Leave it unset to run the
# server read-only, which is the right default for exploring a project.
# JIRA_MCP_ALLOW_WRITES=true
